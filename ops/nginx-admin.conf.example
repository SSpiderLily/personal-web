# Merge into the EXISTING personal-web TLS server. Replace placeholders first.
# Keep every existing /trip/ location and upstream unchanged; do not replace its config.
# Certificates and their renewal must already be configured for the actual hostname.
# Existing root remains /opt/personal-web-deploy/current/frontend/dist.
# HTTP server: redirect this site's non-/trip paths to its exact HTTPS hostname.

# Public HTTPS server locations (replace overlapping existing / and /api/ locations):
location / {
    if (-f /var/lib/personal-web/maintenance) { return 503; }
    try_files $uri $uri/ /index.html;
}
location /assets/ {
    if (-f /var/lib/personal-web/maintenance) { return 503; }
    try_files $uri =404;
}
location /api/ {
    if (-f /var/lib/personal-web/maintenance) { return 503; }
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    # Overwrite client-supplied forwarding headers; only localhost is trusted by Gunicorn.
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    client_max_body_size 11m;
}
location = /__release.txt {
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
}

# ADD a separate loopback-only server in http context. No public maintenance bypass.
# Deployment health_url is http://127.0.0.1:8081; retain the real hostname as health_host.
# This server permits readonly health/UI probes while public writes remain blocked.
# Local users are trusted; do not publish or reverse-proxy this listener.
