# Temporary HTTP public site + SSH-only administration. No TLS impersonation.
# Install only with PRODUCTION_MODE=http_ssh and the matching external env/config.
server {
    listen 80;
    server_name 124.223.69.7;
    root /opt/personal-web-deploy/current/frontend/dist;
    index index.html;

    location ^~ /admin { return 404; }
    location ^~ /api/admin { return 404; }
    location = /api/admin/visits {
        if ($request_method != POST) { return 404; }
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 11m;
    }
    location / {
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        try_files $uri $uri/ /index.html;
    }
    location /assets/ {
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        try_files $uri =404;
    }
    location /api/ {
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 11m;
    }
    location = /__release.txt {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # Existing Trip Planner routes and protected diagnostics retained.
    location = /trip { return 301 /trip/; }
    location = /trip/health {
        proxy_pass http://127.0.0.1:8001/health;
        proxy_set_header Host $http_host;
    }
    location ~ ^/trip/api/trip/(tasks(?:/|$)|v4/tasks/[^/]+/recover-local-access/?$) {
        return 404;
    }
    location /trip/api/ {
        proxy_pass http://127.0.0.1:8001/api/;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 150s;
    }
    location ^~ /trip/assets/ {
        alias /opt/trip-planner/frontend/dist/assets/;
    }
    location = /trip/index.html {
        alias /opt/trip-planner/frontend/dist/index.html;
        add_header Cache-Control "no-cache";
    }
    location /trip/ {
        alias /opt/trip-planner/frontend/dist/;
        index index.html;
        try_files $uri $uri/ /trip/index.html;
    }
}

# Access only using ssh -L 127.0.0.1:18880:127.0.0.1:18880 ubuntu@124.223.69.7.
# The exact Host preserves the browser origin including the SSH forwarded port.
server {
    listen 127.0.0.1:18880;
    server_name 127.0.0.1;
    if ($http_host != "127.0.0.1:18880") { return 404; }
    if (-f /var/lib/personal-web/maintenance) { return 503; }
    root /opt/personal-web-deploy/current/frontend/dist;
    index index.html;
    # Keep production demo links usable while previewing through the SSH origin.
    location = /trip { return 302 http://124.223.69.7/trip/; }
    location /trip/ { return 302 http://124.223.69.7$request_uri; }
    location / { try_files $uri $uri/ /index.html; }
    location /assets/ { try_files $uri =404; }
    location = /__release.txt {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP 127.0.0.1;
        proxy_set_header X-Forwarded-For 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 11m;
    }
}

# Deployment GET probes bypass maintenance. Never expose this listener publicly.
# Only the public API is readable; all admin routes (including visits) are blocked.
server {
    listen 127.0.0.1:18881;
    server_name 124.223.69.7;
    if ($http_host != "124.223.69.7") { return 404; }
    if ($request_method != GET) { return 405; }
    root /opt/personal-web-deploy/current/frontend/dist;
    index index.html;
    location ^~ /admin { return 404; }
    location ^~ /api/admin { return 404; }
    location / { try_files $uri $uri/ /index.html; }
    location /assets/ { try_files $uri =404; }
    location = /__release.txt {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP 127.0.0.1;
        proxy_set_header X-Forwarded-For 127.0.0.1;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
