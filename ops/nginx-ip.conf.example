# 2026-10-25 actual server layout. Install ONLY after the IP certificate exists.
# Review diff before replacing /etc/nginx/conf.d/personal-web.conf.
server {
    listen 80;
    listen 443 ssl;
    server_name 124.223.69.7;
    ssl_certificate /etc/letsencrypt/live/personal-web-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/personal-web-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/personal-web-deploy/current/frontend/dist;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/personal-web-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        if ($scheme = http) { return 308 https://124.223.69.7$request_uri; }
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        try_files $uri $uri/ /index.html;
    }
    location /assets/ {
        if ($scheme = http) { return 308 https://124.223.69.7$request_uri; }
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        try_files $uri =404;
    }
    location /api/ {
        if ($scheme = http) { return 308 https://124.223.69.7$request_uri; }
        if (-f /var/lib/personal-web/maintenance) { return 503; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 11m;
    }
    location = /__release.txt {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # Existing Trip Planner routes and protected diagnostics retained.
    location = /trip { return 301 /trip/; }
    location = /trip/health {
        proxy_pass http://127.0.0.1:8001/health;
        proxy_set_header Host $host;
    }
    location ~ ^/trip/api/trip/(tasks(?:/|$)|v4/tasks/[^/]+/recover-local-access/?$) {
        return 404;
    }
    location /trip/api/ {
        proxy_pass http://127.0.0.1:8001/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 150s;
    }
    location ^~ /trip/assets/ {
        alias /opt/trip-planner/frontend/dist/assets/;
    }
    location = /trip/index.html {
        alias /opt/trip-planner/frontend/dist/index.html;
        add_header Cache-Control "no-cache";
    }
    location /trip/ {
        alias /opt/trip-planner/frontend/dist/;
        index index.html;
        try_files $uri $uri/ /trip/index.html;
    }
}

# Private health/probe listener: never expose/proxy this port publicly.
server {
    listen 127.0.0.1:8081;
    server_name 124.223.69.7;
    root /opt/personal-web-deploy/current/frontend/dist;
    location / { try_files $uri $uri/ /index.html; }
    location /assets/ { try_files $uri =404; }
    location = /__release.txt {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size 11m;
    }
}
