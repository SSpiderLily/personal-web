# Local backend settings. Keep this file out of Git.
# Connect to the cloud development database through the SSH tunnel on 15432.
APP_ENV=development
DEBUG=true
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=personal_web_dev
DB_USER=personal_web_dev
# Fill in locally before database integration. Never send or commit the password.
DB_PASSWORD=""

# Local launcher only; use a host/IP or existing SSH config alias.
DEV_SSH_HOST=your-server-ip
DEV_SSH_USER=ubuntu
DEV_SSH_PORT=22
DEV_DB_REMOTE_PORT=5432
DEV_BACKEND_PORT=8010
