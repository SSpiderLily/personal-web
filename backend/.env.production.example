# Install as /etc/personal-web/app.env, outside release directories.
# systemd EnvironmentFile supplies these values to the service process.
APP_ENV=production
DEBUG=false
# Default production mode requires HTTPS. Temporary IP frontend + SSH admin:
# PRODUCTION_MODE=http_ssh
# PUBLIC_ORIGIN=http://124.223.69.7
# ADMIN_ALLOWED_ORIGINS=["http://127.0.0.1:18880"]
# In http_ssh mode the public proxy must deny /admin and /api/admin except
# exact POST /api/admin/visits; admin listener binds only 127.0.0.1:18880.
PRODUCTION_MODE=https
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=personal_web_prod
DB_USER=personal_web_prod
# Replace with the production account password on the server before restarting.
DB_PASSWORD=""

# Persistent private uploads; owner must be the app/deployment user (0700).
UPLOAD_DIR=/var/lib/personal-web/uploads
# Replace with exact real HTTPS origins, JSON array. Empty fails production bootstrap.
ADMIN_ALLOWED_ORIGINS=[]
ADMIN_SESSION_HOURS=8
